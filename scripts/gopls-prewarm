#!/usr/bin/env bash
# gopls-prewarm <worktree> [file.go]
#
# Warm gopls' on-disk cache (~/Library/Caches/gopls) for a freshly created Go
# worktree so the first real nvim open there loads in ~20-40s instead of ~70s
# (lovable go.work: 148 modules / 5240 packages; the prewarm itself takes
# ~80s). Type-check cache keys include file paths, so a new worktree is always
# cold until something loads it.
#
# Runs a headless nvim with the normal config (so it attaches to the same
# per-toolchain gopls daemon as interactive sessions, see lsp/gopls.lua),
# opens one Go file, waits for gopls' whole-workspace diagnostics pass to end,
# then quits. Wired into `wt switch --create` via the worktrunk [post-start]
# hook; safe to run by hand.
set -euo pipefail

wt=${1:?worktree path}
cd "$wt"
file=${2:-}
if [ -z "$file" ]; then
  [ -f go.work ] || [ -f go.mod ] || exit 0 # not a Go repo
  file=$(git ls-files -z -- '*.go' | tr '\0' '\n' | grep -v '_test\.go$' | head -1 || true)
  [ -n "$file" ] || exit 0
fi

# direnv trust is per path, so a fresh worktree's .envrc is always blocked
# until someone cds in and runs `direnv allow`. When it is byte-identical to
# the main checkout's already-trusted .envrc, allowing it adds no new trust.
if [ -f .envrc ] && command -v direnv >/dev/null 2>&1; then
  if ! direnv exec . true >/dev/null 2>&1; then
    main=$(git worktree list --porcelain | awk 'NR==1 && $1=="worktree" {print $2}')
    if [ -n "$main" ] && [ "$main" != "$PWD" ] && cmp -s "$main/.envrc" .envrc \
       && (cd "$main" && direnv exec . true >/dev/null 2>&1); then
      direnv allow .
      echo "gopls-prewarm: direnv allow (identical to $main/.envrc)"
    else
      echo "gopls-prewarm: .envrc blocked, skipping (run: direnv allow)" >&2
      exit 0
    fi
  fi
  run() { direnv exec . "$@"; }
else
  run() { "$@"; }
fi

lua=$(mktemp "${TMPDIR:-/tmp}/gopls-prewarm.XXXXXX")
trap 'rm -f "$lua"' EXIT
cat >"$lua" <<'LUA'
-- Type-checking a clean repo emits no client-visible events, so "quiet" is not
-- a usable done-signal. gopls' verboseWorkDoneProgress (a testing option)
-- wraps each diagnostics pass in a progress token. Opening our file
-- supersedes the initial snapshot (its "diagnosing initial workspace load"
-- token ends early), and the pass for the new snapshot, "diagnosing opened
-- files", re-diagnoses every workspace package; its `end` is the signal
-- (measured: ends when a following `gopls stats` drops from ~70s to ~20s).
-- Must arrive via init_options: nvim sends `settings` only after `initialize`.
vim.lsp.config("gopls", { init_options = { verboseWorkDoneProgress = true } })
local INITIAL, OPENED = "diagnosing initial workspace load", "diagnosing opened files"
local t0 = vim.uv.now()
local ended, titles = {}, {} -- titles: progress token -> title
local function since() return string.format("%5.1fs", (vim.uv.now() - t0) / 1000) end
vim.api.nvim_create_autocmd("LspProgress", {
  callback = function(a)
    local c = vim.lsp.get_client_by_id(a.data.client_id)
    if not c or c.name ~= "gopls" then return end
    local tok, v = a.data.params.token, a.data.params.value
    if v.kind == "begin" then
      titles[tok] = v.title
      io.stdout:write(string.format("gopls-prewarm: %s begin %s\n", since(), v.title))
    elseif v.kind == "end" and titles[tok] then -- `end` carries no title
      ended[titles[tok]] = true
      io.stdout:write(string.format("gopls-prewarm: %s end   %s\n", since(), titles[tok]))
    end
  end,
})
local timer = vim.uv.new_timer()
local quitting = false
timer:start(1000, 1000, vim.schedule_wrap(function()
  if quitting then return end -- :qa! waits for the LSP shutdown handshake
  local now = vim.uv.now()
  local attached = #vim.lsp.get_clients({ name = "gopls" }) > 0
  local msg = (ended[OPENED] and ended[INITIAL] and "done in " .. since())
    or (not attached and now - t0 > 30000 and "gopls never attached (30s)")
    or (now - t0 > 600000 and "hard cap 10min hit")
  if msg then
    quitting = true
    io.stdout:write("gopls-prewarm: " .. msg .. "\n")
    timer:stop()
    vim.cmd("qa!")
  end
end))
vim.cmd.edit(vim.env.GOPLS_PREWARM_FILE)
LUA

start=$(date +%s)
GOPLS_PREWARM_FILE=$file run nvim --headless -c "luafile $lua"
echo "gopls-prewarm: $wt done in $(( $(date +%s) - start ))s"
