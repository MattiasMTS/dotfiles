{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "paneBorderColor": "#4A4540",
  "activePaneBorderColor": "#7A4FD8",
  "app": {
    "sendAnonymousTelemetry": false,
    "confirmQuit": "never",
    "commandPaletteSearchesAllSurfaces": true
  },
  "notifications": {
    "suppressOnlyFocusedSurface": true
  },
  "customSidebars": {
    "beta": {
      "enabled": true
    }
  },
  "browser": {
    "openTerminalLinksInCmuxBrowser": false,
    "interceptTerminalOpenCommandInCmuxBrowser": false,
    "urlsToAlwaysOpenExternally": [
      "github.com"
    ]
  },
  "sidebar": {
    "hideAllDetails": false,
    "wrapWorkspaceTitles": true,
    "showWorkspaceDescription": true,
    "branchLayout": "vertical",
    "stackBranchDirectory": true,
    "showNotificationMessage": true,
    "showBranchDirectory": true,
    "showPullRequests": true,
    "watchGitStatus": true,
    "makePullRequestsClickable": true,
    "openPullRequestLinksInCmuxBrowser": false,
    "openPortLinksInCmuxBrowser": false,
    "showLog": true,
    "showProgress": true,
    "showCustomMetadata": true
  },
  "workspaceColors": {
    "indicatorStyle": "solidFill",
    "selectionColor": "#4A4540"
  },
  "workspaceGroups": {
    "byCwd": {
      "/Users/mattiassjodin/src/github.com/lovablelabs/lovable": {
        "icon": "ladybug.fill",
        "color": "#7A4FD8"
      },
      "/Users/mattiassjodin/src/github.com/projects/dotfiles": {
        "icon": "gearshape.fill",
        "color": "#8E8E93"
      },
      "/Users/mattiassjodin/src/github.com/projects/manicule.nvim": {
        "icon": "hand.point.up.left.fill",
        "color": "#D87A4F"
      }
    }
  },
  "sidebarAppearance": {
    "matchTerminalBackground": false,
    "tintOpacity": 0.4
  },
  "automation": {
    "claudeCodeIntegration": true
  },
  "shortcuts": {
    "bindings": {
      "newSurface": [
        "ctrl+a",
        "c"
      ],
      "splitDown": [
        "ctrl+a",
        "shift+quote"
      ],
      "splitRight": [
        "ctrl+a",
        "shift+5"
      ],
      "prevSurface": [
        "ctrl+a",
        "a"
      ],
      "nextSurface": [
        "ctrl+a",
        "n"
      ],
      "toggleSplitZoom": [
        "ctrl+a",
        "z"
      ],
      "closeTab": [
        "ctrl+a",
        "x"
      ],
      "closeWorkspace": [
        "ctrl+a",
        "shift+x"
      ],
      "nextSidebarTab": [
        "ctrl+a",
        "tab"
      ],
      "prevSidebarTab": [
        "ctrl+a",
        "shift+tab"
      ],
      "goToWorkspace": [
        "ctrl+a",
        "f"
      ],
      "toggleSidebar": [
        "ctrl+a",
        "b"
      ],
      "reloadConfiguration": [
        "ctrl+a",
        "shift+r"
      ],
      "newTab": [
        "ctrl+a",
        "w"
      ],
      "commandPalette": [
        "ctrl+a",
        "p"
      ],
      "focusLeft": "ctrl+h",
      "focusDown": "ctrl+j",
      "focusUp": "ctrl+k",
      "focusRight": "ctrl+l",
      "renameTab": [
        "ctrl+a",
        "comma"
      ],
      "renameWorkspace": [
        "ctrl+a",
        "shift+4"
      ],
      "selectSurfaceByNumber": [
        "ctrl+a",
        "1"
      ],
      "toggleTerminalCopyMode": [
        "ctrl+a",
        "\u001b"
      ]
    }
  }
}
