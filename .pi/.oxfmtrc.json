{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"ignorePatterns": [
		"agent/sessions/**",
		"agent/npm/**",
		"agent/git/**",
		"agent/extensions/plan/generated/**",
		"node_modules/**"
	]
}
